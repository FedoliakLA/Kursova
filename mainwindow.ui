  <property name="styleSheet">
   <string notr="true">
    QMainWindow, QWidget#centralwidget, QWidget#filterPanel, QWidget#flatsContainer { background: #ffffff; }
    QScrollArea { border: none; background: #ffffff; }
    QWidget#qt_scrollarea_viewport { background: #ffffff; }
    QWidget#sidebar { background: #000000; }

    QLabel { color: #222222; background: transparent; }
    QLabel#lblLogo { color: #ff7a1a; font-size: 26px; font-weight: bold; }
    QLabel#capDistrict, QLabel#capRooms, QLabel#capArea, QLabel#capPrice { color: #222222; font-size: 12px; }
    QLabel#lblAnalytics { color: #222222; font-size: 13px; font-weight: bold; }
    QLabel#lblFooter { color: #888888; font-size: 11px; }
    QLabel#lblAddress { color: #222222; font-size: 13px; font-weight: bold; }
    QLabel#lblMeta { color: #555555; font-size: 12px; }
    QLabel#lblCardPrice {
        background: #ff7a1a; color: #ffffff; border-radius: 8px; padding: 4px 10px; font-weight: bold;
    }

    QCheckBox { color: #222222; background: transparent; spacing: 6px; }
    QCheckBox::indicator {
        width: 16px; height: 16px; border: 2px solid #8a8a8a; border-radius: 4px; background: #ffffff;
    }
    QCheckBox::indicator:hover { border-color: #ff7a1a; }
    QCheckBox::indicator:checked { background: #ff7a1a; border-color: #ff7a1a; }

    QComboBox, QLineEdit {
        color: #222222; background: #ffffff;
        border: 1px solid #c4c4c4; border-radius: 6px; padding: 4px 8px;
    }
    QComboBox:disabled, QLineEdit:disabled { background: #f0f0f0; color: #aaaaaa; border-color: #e0e0e0; }
    QComboBox QAbstractItemView {
        background: #ffffff; color: #222222; border: 1px solid #c4c4c4;
        selection-background-color: #ff7a1a; selection-color: #ffffff;
    }

    QMenu { background: #ffffff; color: #222222; border: 1px solid #d0d0d0; padding: 4px; }
    QMenu::item { padding: 8px 22px; border-radius: 6px; }
    QMenu::item:selected { background: #ff7a1a; color: #ffffff; }

    QPushButton#btnFilters, QPushButton#btnReports {
        color: #ffffff; background: transparent; border: none;
        text-align: left; padding: 12px 16px; font-size: 14px; border-radius: 8px;
    }
    QPushButton#btnFilters:checked, QPushButton#btnFilters:hover, QPushButton#btnReports:hover {
        background: #ff7a1a;
    }

    QPushButton#btnAdd {
        background: #ff7a1a; color: #ffffff; border: none; border-radius: 8px;
        font-size: 20px; font-weight: bold; padding: 0;
    }
    QPushButton#btnAdd:hover { background: #e96a0c; }

    QPushButton#btnApply {
        background: #ff7a1a; color: #ffffff; border: none; border-radius: 8px;
        padding: 8px 18px; font-weight: bold;
    }
    QPushButton#btnApply:hover { background: #e96a0c; }

    QFrame#flatCard {
        background: #ffffff; border: 1px solid #e3e3e3; border-radius: 12px;
    }

    QTextEdit#logView {
        color: #222222; background: #ffffff; border: 1px solid #d0d0d0; border-radius: 8px;
        font-family: Consolas, monospace; font-size: 12px;
    }
